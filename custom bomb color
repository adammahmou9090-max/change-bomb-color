local function makeButton(parent, text, color, callback, height)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, height or 29)
    b.BackgroundColor3 = color or Color3.fromRGB(40, 40, 48)
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.Parent = parent
    corner(b, 5)
    b.Activated:Connect(callback)
    return b
end

makeButton(colorList, "RGB", Color3.fromRGB(100, 50, 150), function()
    rainbowColor = not rainbowColor
    if rainbowColor then
        selectedColor = nil
    end
    apply()
end)

for _, data in ipairs(colors) do
    local name = data[1]
    local color = Color3.fromRGB(data[2], data[3], data[4])

    makeButton(colorList, name, color, function()
        rainbowColor = false
        selectedColor = color
        apply()
    end)
end

for _, effect in ipairs({"Rainbow", "Pink", "Blue", "Gray"}) do
    makeButton(effectList, effect .. " Sparkling",
        Color3.fromRGB(40, 40, 48), function()
            selectedEffect = effect
            rainbowEffect = effect == "Rainbow"
            apply()
        end, 18)
end

activeConnections.heartbeat = RunService.Heartbeat:Connect(function(dt)
    if rainbowColor or rainbowEffect then
        hue = (hue + dt * 0.5) % 1
        apply()
    end
end)

