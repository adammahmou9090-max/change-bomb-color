local selectedColor = Color3.fromRGB(0, 160, 255)
local selectedEffect = nil
local rainbowColor = false
local rainbowEffect = false
local hue = 0
local activeConnections = {}
local original = {}
local targets = {}

local function disconnect(key)
    if activeConnections[key] then
        activeConnections[key]:Disconnect()
        activeConnections[key] = nil
    end
end

local function getBombs()
    local found = {}
    local backpack = player:FindFirstChildOfClass("Backpack")
    local containers = {player.Character, backpack}

    for _, container in ipairs(containers) do
        if container then
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") then
                    local n = tool.Name:lower()
                    if n:find("bomb") or n:find("c4") or n:find("gold") then
                        table.insert(found, tool)
                    end
                end
            end
        end
    end
    return found
end

local function remember(obj)
    if original[obj] then return end
    if obj:IsA("BasePart") then
        original[obj] = {
            Color = obj.Color,
            Material = obj.Material,
        }
    elseif obj:IsA("SpecialMesh") then
        original[obj] = {
            TextureId = obj.TextureId,
        }
    end
end

local function paint(tool, color)
    for _, obj in ipairs(tool:GetDescendants()) do
        remember(obj)

        if obj:IsA("BasePart") then
            obj.Color = color
            obj.Material = Enum.Material.SmoothPlastic

            if obj:IsA("MeshPart") then
                obj.TextureID = ""
            end
        elseif obj:IsA("SpecialMesh") then
            obj.TextureId = ""
        end
    end
end

local function apply()
    for _, tool in ipairs(getBombs()) do
        if rainbowColor then
            paint(tool, Color3.fromHSV(hue, 1, 1))
        elseif selectedColor then
            paint(tool, selectedColor)
        end

        local handle = tool:FindFirstChild("Handle")
            or tool:FindFirstChildWhichIsA("BasePart")

        if handle and selectedEffect then
            local sparkle = handle:FindFirstChild("AEATZZE_Sparkle")

            if not sparkle then
                sparkle = Instance.new("Sparkles")
                sparkle.Name = "AEATZZE_Sparkle"
                sparkle.Parent = handle
            end

            if rainbowEffect then
                sparkle.SparkleColor = Color3.fromHSV(hue, 1, 1)
            elseif selectedEffect == "Pink" then
                sparkle.SparkleColor = Color3.fromRGB(255, 105, 180)
            elseif selectedEffect == "Blue" then
                sparkle.SparkleColor = Color3.fromRGB(0, 191, 255)
            elseif selectedEffect == "Gray" then
                sparkle.SparkleColor = Color3.fromRGB(128, 128, 128)
            end
        end
    end
end

